{
  "name": "felfelchat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:next": "next dev -p 3001 -H 127.0.0.1",
    "dev:api": "SERVE_FRONTEND=false cargo run",
    "build": "next build && cargo build --release",
    "start": "NODE_ENV=production SERVE_FRONTEND=true ./target/release/felfel-server",
    "lint": "eslint",
    "db:seed": "cargo run -- seed-superadmin"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^17.3.1",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7"
  }
}
